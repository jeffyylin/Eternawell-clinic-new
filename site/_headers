# Netlify reads this file because site/ is the published folder, and netlify.toml sets the same headers plus
# the ones for /admin/. Keep the two in step; netlify.toml wins where they disagree.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
